# Anthropic API (Required)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Environment
ENVIRONMENT=development

# ChromaDB
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Logging
LOG_LEVEL=INFO

# LangSmith Tracing (optional — uncomment to enable)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-api-key
# LANGCHAIN_PROJECT=agentic-wealth-intelligence

# OpenAI API (optional — enables GPT-4o in model selector)
# OPENAI_API_KEY=your-openai-api-key-here

# Gemini API (optional — enables Gemini in model selector)
# GEMINI_API_KEY=your-gemini-api-key-here

# ============================================
# Financial Data APIs (for RAG data collection)
# All optional — app works without these via yfinance
# ============================================

# Alpha Vantage - enables "Collect News" in Knowledge Search tab
# Get your free key at: https://www.alphavantage.co/support/#api-key
# ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key-here

# NewsAPI - enables NewsAPI news collector
# Get your free key at: https://newsapi.org/
# NEWS_API_KEY=your-newsapi-key-here

# SEC EDGAR - No API key needed, just identification
# Format: "Your Name your@email.com" (required by SEC)
# SEC_USER_AGENT=name@example.com

# Finnhub - Alternative financial data API (optional)
# Get your free key at: https://finnhub.io/
# FINNHUB_API_KEY=your-finnhub-api-key-here

# Reddit API (optional)
# REDDIT_CLIENT_ID=your-reddit-client-id
# REDDIT_SECRET=your-reddit-client-secret

# ============================================
# User Management
# ============================================

# Admin password for the User Management tab in the Streamlit UI
# ADMIN_PASSWORD=your-admin-password

# ============================================
# Plaid Integration (real account connections)
# ============================================
# Get your credentials at: https://dashboard.plaid.com/
#
# Sandbox -> Limited Production migration:
#   1. In Plaid dashboard, copy the "Development" secret key
#   2. Set PLAID_ENV=development and PLAID_SECRET=<development-secret>
#   3. Generate an encryption key (required for development/production):
#      python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# PLAID_CLIENT_ID=your-plaid-client-id
# PLAID_SANDBOX_SECRET=your-plaid-sandbox-secret  # sandbox secret — enables "Connect Sandbox" button
# PLAID_SECRET=your-plaid-production-secret       # production secret — enables "Connect Production" button
#   Note: Both buttons can be active simultaneously. Set whichever secrets you have.
#   Plaid deprecated "development" env. Limited Production uses the production host + secret.
# PLAID_ENCRYPTION_KEY=your-fernet-key            # required when using production
#   Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Comma-separated Plaid products to request at connection time.
# Must match products enabled in your Plaid dashboard.
# PLAID_PRODUCTS=transactions,investments          # transactions | investments | identity

# FastAPI backend URL used by the Streamlit Plaid Link component
# BACKEND_URL=http://localhost:8000
